# Unity generated folders
Library/
Temp/
Obj/
UserSettings/

# Build folders
Builds/
Logs/

# Visual Studio
.vs/
.vscode/

# OS generated files
.DS_Store
Thumbs.db

# Unity project files to ignore
*.pidb
*.pdb
*.user
*.suo
*.userprefs
*.tmp
*.bak
*.swp
*.swn
*~

# DO NOT ignore .meta files (Unity needs them)
# DO NOT ignore .dll files globally

# Allow Plugins DLLs
!Assets/Plugins/*.dll

# Allow QuantumApi code
!Assets/QuantumApi/**

# Allow Unity package lock file
!Packages/packages-lock.json

# Allow Unity version file
!ProjectSettings/ProjectVersion.txt

# Ignore screenshots and editor-only assets
Assets/Screenshots/
Assets/Editor/

# Ignore specific project files
Assembly-CSharp.csproj
Assembly-CSharp-Editor.csproj
QuantumApi.Unity.csproj
QRNG.PlayModeTests.csproj
*.slnx
